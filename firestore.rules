rules_version = '2';

// Crate — Firestore security rules
// Deploy: firebase deploy --only firestore:rules
//
// Users own their profile. Track catalog is publicly readable.
// Signed-in users may only nudge popularity counters on tracks.
// Admin (custom claim or known UID) may create/update/delete tracks.
// Sessions are private to the creating user.
// Billing/subscription fields: clients may start a trial; paid status is admin-only
// until a Stripe webhook (Admin SDK) writes active subscriptions.
// Mixtape Club: public mixes readable by anyone; owners write their mixes;
// community monthly mixes are admin-only writes.
// Member counter: signed-in users may increment counters/members.next by 1.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.uid == '5lPAI9N1jkMbVkUyIqLTqBvBf1t1'
      );
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Paid / Stripe-managed fields — only Admin SDK or admin UID may set these
    // to privileged values. Clients may write trialing defaults on create/backfill.
    function billingKeysTouched() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['subscriptionStatus', 'plan', 'stripeCustomerId', 'stripeSubscriptionId', 'trialEndsAt', 'trialStartedAt']);
    }

    function isTrialingWrite() {
      let status = request.resource.data.get('subscriptionStatus', '');
      let plan = request.resource.data.get('plan', '');
      return status == 'trialing' && plan == 'trial'
        && request.resource.data.get('stripeCustomerId', null) == null
        && request.resource.data.get('stripeSubscriptionId', null) == null;
    }

    function isPaidStatus() {
      let status = request.resource.data.get('subscriptionStatus', '');
      return status in ['active', 'past_due', 'canceled', 'unpaid'];
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid) && (
        !('subscriptionStatus' in request.resource.data)
        || isTrialingWrite()
        || isAdmin()
      );

      allow update: if isOwner(uid) && (
        isAdmin()
        || !billingKeysTouched()
        || (
          // One-time trial backfill when billing fields were never set
          !('trialEndsAt' in resource.data)
          && isTrialingWrite()
          && !isPaidStatus()
        )
      );

      allow delete: if isOwner(uid) || isAdmin();
    }

    match /tracks/{trackId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['playCount', 'skipCount', 'likeCount'])
      );
    }

    match /sessions/{sessionId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Global member number counter
    match /counters/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && id == 'members'
        && request.resource.data.keys().hasOnly(['next'])
        && request.resource.data.next is int
        && request.resource.data.next >= 2;
      allow update: if isSignedIn() && id == 'members'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['next'])
        && request.resource.data.next is int
        && request.resource.data.next == resource.data.next + 1;
    }

    // Mixtape Club — shareable mixes + monthly Community Mix
    match /mixes/{mixId} {
      allow read: if resource.data.visibility in ['public', 'unlisted']
        || (isSignedIn() && resource.data.ownerUid == request.auth.uid)
        || isAdmin();

      allow create: if isSignedIn() && (
        (
          request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.kind == 'user'
          && request.resource.data.visibility in ['public', 'unlisted', 'private']
        )
        || (
          isAdmin()
          && request.resource.data.kind == 'community_monthly'
        )
      );

      allow update: if isSignedIn() && (
        (
          resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == request.auth.uid
          && resource.data.kind == 'user'
          && request.resource.data.kind == 'user'
        )
        || isAdmin()
      );

      allow delete: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid
        || isAdmin()
      );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
