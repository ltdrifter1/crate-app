# Hashed webpack assets — immutable (filename includes content hash)
/static/js/*
  Cache-Control: public, max-age=31536000, immutable

/static/css/*
  Cache-Control: public, max-age=31536000, immutable

/static/media/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted brand fonts. Not content-hashed, so 30 days rather than immutable.
# With font-display: optional a revalidating font can be skipped, so keep them fresh in cache.
/fonts/*
  Cache-Control: public, max-age=2592000

# HTML / SPA shell — always revalidate so new deploys take effect
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
