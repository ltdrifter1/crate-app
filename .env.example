# Example environment variables for local scripts (fix_genres.py, etc.)
DISCOGS_TOKEN=
LASTFM_KEY=

# Cover transforms (client). Default in production is Cloudflare Image Resizing.
#   cf       — /cdn-cgi/image/width=W,quality=Q,format=auto/<origin> (default)
#   firebase — Resize Images extension thumbs (file_200x200.jpg beside original)
#   off      — originals only
REACT_APP_COVER_RESIZE=cf

# Catalog JSON on Storage (functions publish catalog/v1.json). Set `off` to skip.
# REACT_APP_CATALOG_URL=https://firebasestorage.googleapis.com/v0/b/crate-app-58494.firebasestorage.app/o/catalog%2Fv1.json?alt=media

# Stripe (functions + scripts/stripe-provision-products.js)
# Prefer a restricted key (rk_) over a secret key (sk_).
STRIPE_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CLUB_PRICE_ID=
STRIPE_PREMIUM_PRICE_ID=
